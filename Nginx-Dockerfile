FROM rockylinux:8

RUN dnf update -y && \
    dnf install -y nginx net-tools bind-utils vim && \
    dnf clean all
COPY ./index.html /usr/share/nginx/html
COPY ./nginx.conf /etc/nginx/conf.d/default.conf 

VOLUME /usr/share/nginx/html 
VOLUME /etc/nginx

EXPOSE 80 443

CMD ["nginx","-g","daemon off;"]

